      enable_gfx_replay_save: false
    ep_info: null
    object_ids_start: 100
  task:
    reward_measure: distance_to_goal_reward
    success_measure: spl
    success_reward: 2.5
    slack_reward: -0.001
    end_on_success: true
    type: ObjectNav-v1
    lab_sensors:
      objectgoal_sensor:
        type: ObjectGoalSensor
        goal_spec: TASK_CATEGORY_ID
