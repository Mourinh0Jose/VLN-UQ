        type: TurnRightAction
        agent_index: 0
      look_up:
        type: LookUpAction
        agent_index: 0
      look_down:
        type: LookDownAction
        agent_index: 0
  dataset:
    type: ObjectNav-v1
    split: val_5scene_90
    scenes_dir: data/scene_datasets
    content_scenes:
    - '*'
